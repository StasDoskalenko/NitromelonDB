{
  "name": "React-CoreModules",
  "version": "0.87.0",
  "summary": "-",
  "homepage": "https://reactnative.dev/",
  "license": "MIT",
  "authors": "Meta Platforms, Inc. and its affiliates",
  "platforms": {
    "ios": "15.1"
  },
  "compiler_flags": "-Wno-nullability-completeness",
  "source": {
    "git": "https://github.com/facebook/react-native.git",
    "tag": "v0.87.0"
  },
  "source_files": "**/*.h",
  "ios": {
    "exclude_files": "PlatformStubs/**/*"
  },
  "osx": {
    "exclude_files": [
      "RCTStatusBarManager.mm"
    ]
  },
  "visionos": {
    "exclude_files": [
      "RCTStatusBarManager.mm"
    ]
  },
  "tvos": {
    "exclude_files": [
      "RCTStatusBarManager.mm"
    ]
  },
  "header_dir": "CoreModules",
  "pod_target_xcconfig": {
    "USE_HEADERMAP": "YES",
    "CLANG_CXX_LANGUAGE_STANDARD": "c++20",
    "HEADER_SEARCH_PATHS": [
      "$(PODS_TARGET_SRCROOT)/React/CoreModules",
      "${PODS_ROOT}/Headers/Public/ReactCodegen/react/renderer/components",
      "${PODS_ROOT}/React-featureflags",
      "${PODS_ROOT}/React-debug",
      "${PODS_ROOT}/React-runtimeexecutor",
      "${PODS_ROOT}/React-runtimeexecutor/platform/ios",
      "${PODS_ROOT}/React-jsinspector",
      "${PODS_ROOT}/React-jsinspectorcdp",
      "${PODS_ROOT}/React-jsinspectortracing",
      "${PODS_ROOT}/React-RCTFBReactNativeSpec",
      "${PODS_ROOT}/ReactCommon",
      "${PODS_ROOT}/ReactCommon/react/nativemodule/core",
      "${PODS_ROOT}/React-NativeModulesApple",
      "${PODS_ROOT}/React-utils",
      "${PODS_ROOT}/React-utils/react/utils/platform/ios",
      "$(PODS_ROOT)/ReactNativeDependencies/Headers"
    ]
  },
  "frameworks": "UIKit",
  "dependencies": {
    "RCTTypeSafety": [
      "0.87.0"
    ],
    "React-Core/CoreModulesHeaders": [
      "0.87.0"
    ],
    "React-RCTImage": [
      "0.87.0"
    ],
    "React-jsi": [
      "0.87.0"
    ],
    "React-featureflags": [],
    "React-RCTBlob": [],
    "React-debug": [],
    "React-runtimeexecutor": [],
    "React-jsinspector": [],
    "React-jsinspectorcdp": [],
    "React-jsinspectortracing": [],
    "React-RCTFBReactNativeSpec": [],
    "ReactCommon": [],
    "React-NativeModulesApple": [],
    "React-utils": [],
    "ReactNativeDependencies": [],
    "React-Core-prebuilt": []
  }
}
