{
  "name": "NitromelonDB",
  "version": "0.30.0-beta.0",
  "summary": "Reactive SQLite database for React Native and React web. A maintained fork of WatermelonDB.",
  "description": "Reactive SQLite database for React Native and React web. A maintained fork of WatermelonDB.",
  "homepage": "https://stasdoskalenko.github.io/NitromelonDB/",
  "license": "MIT",
  "authors": {
    "author": {
      "name": "Stanislav Doskalenko",
      "url": "https://github.com/StasDoskalenko"
    }
  },
  "platforms": {
    "ios": "15.1",
    "tvos": "15.1"
  },
  "source": {
    "git": "https://github.com/StasDoskalenko/NitromelonDB.git",
    "tag": "v0.30.0-beta.0"
  },
  "source_files": [
    "native/ios/**/*.{h,m,mm,swift,c,cpp}",
    "native/shared/**/*.{h,c,cpp}",
    "native/nitro/**/*.{h,hpp,c,cpp}",
    "native/vendor/simdjson/*.{h,cpp}",
    "nitrogen/generated/shared/**/*.{h,hpp,c,cpp,swift}",
    "nitrogen/generated/ios/**/*.{h,hpp,c,cpp,mm,swift}"
  ],
  "public_header_files": [
    "native/ios/WatermelonDB/JSIInstaller.h",
    "native/ios/WatermelonDB/WatermelonDB.h",
    "nitrogen/generated/shared/**/*.{h,hpp}",
    "nitrogen/generated/ios/NitromelonDB-Swift-Cxx-Bridge.hpp"
  ],
  "private_header_files": [
    "native/vendor/simdjson/*.h",
    "nitrogen/generated/ios/c++/**/*.{h,hpp}",
    "nitrogen/generated/shared/**/views/**/*"
  ],
  "pod_target_xcconfig": {
    "HEADER_SEARCH_PATHS": [
      "$(inherited)",
      "$(PODS_TARGET_SRCROOT)/native/nitro",
      "$(PODS_TARGET_SRCROOT)/native/shared",
      "$(PODS_TARGET_SRCROOT)/nitrogen/generated/shared/c++",
      "$(PODS_TARGET_SRCROOT)/native/vendor",
      "$(PODS_TARGET_SRCROOT)/native/vendor/simdjson",
      "$(PODS_ROOT)/Headers/Private/Yoga",
      "$(PODS_ROOT)/ReactNativeDependencies/Headers"
    ],
    "CLANG_CXX_LANGUAGE_STANDARD": "c++20",
    "OTHER_CPLUSPLUSFLAGS": "$(inherited) -DRCT_NEW_ARCH_ENABLED=1 ",
    "OTHER_SWIFT_FLAGS": "$(inherited) -DRCT_NEW_ARCH_ENABLED",
    "SWIFT_OBJC_INTEROP_MODE": "objcxx",
    "DEFINES_MODULE": "YES",
    "SWIFT_INSTALL_OBJC_HEADER": "NO"
  },
  "requires_arc": true,
  "compiler_flags": "-Os  -DRCT_NEW_ARCH_ENABLED=1",
  "libraries": "sqlite3",
  "dependencies": {
    "React-Core": [],
    "React-jsi": [],
    "React-callinvoker": [],
    "React-RCTFabric": [],
    "ReactCodegen": [],
    "RCTRequired": [],
    "RCTTypeSafety": [],
    "React-bridging": [],
    "ReactCommon/turbomodule/core": [],
    "React-NativeModulesApple": [],
    "Yoga": [],
    "React-Fabric": [],
    "React-graphics": [],
    "React-utils": [],
    "React-featureflags": [],
    "React-debug": [],
    "React-ImageManager": [],
    "React-rendererdebug": [],
    "React-renderercss": [],
    "hermes-engine": [],
    "ReactNativeDependencies": [],
    "React-Core-prebuilt": [],
    "NitroModules": []
  }
}
