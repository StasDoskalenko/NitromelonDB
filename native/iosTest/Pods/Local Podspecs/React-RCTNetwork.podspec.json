{
  "name": "React-RCTNetwork",
  "version": "0.87.0",
  "summary": "The networking library of React Native.",
  "homepage": "https://reactnative.dev/",
  "license": "MIT",
  "authors": "Meta Platforms, Inc. and its affiliates",
  "platforms": {
    "ios": "15.1"
  },
  "compiler_flags": "-Wno-nullability-completeness",
  "source": {
    "git": "https://github.com/facebook/react-native.git",
    "tag": "v0.87.0"
  },
  "source_files": "",
  "preserve_paths": [
    "package.json",
    "LICENSE",
    "LICENSE-docs"
  ],
  "header_dir": "RCTNetwork",
  "pod_target_xcconfig": {
    "USE_HEADERMAP": "YES",
    "CLANG_CXX_LANGUAGE_STANDARD": "c++20",
    "HEADER_SEARCH_PATHS": [
      "${PODS_ROOT}/Headers/Public/ReactCodegen/react/renderer/components",
      "${PODS_ROOT}/React-debug",
      "${PODS_ROOT}/React-RCTFBReactNativeSpec",
      "${PODS_ROOT}/ReactCommon",
      "${PODS_ROOT}/ReactCommon/react/nativemodule/core",
      "${PODS_ROOT}/React-featureflags",
      "${PODS_ROOT}/React-jsinspectorcdp",
      "${PODS_ROOT}/React-jsinspectornetwork",
      "${PODS_ROOT}/React-NativeModulesApple",
      "${PODS_ROOT}/React-NativeModulesApple/build/generated/ios",
      "${PODS_ROOT}/React-networking",
      "$(PODS_ROOT)/ReactNativeDependencies/Headers"
    ]
  },
  "frameworks": "MobileCoreServices",
  "dependencies": {
    "RCTTypeSafety": [],
    "React-jsi": [],
    "React-Core/RCTNetworkHeaders": [],
    "React-debug": [],
    "React-RCTFBReactNativeSpec": [],
    "ReactCommon": [],
    "React-featureflags": [],
    "React-jsinspectorcdp": [],
    "React-jsinspectornetwork": [],
    "React-NativeModulesApple": [],
    "React-networking": [],
    "ReactNativeDependencies": [],
    "React-Core-prebuilt": []
  }
}
