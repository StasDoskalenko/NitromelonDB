OTHER_LDFLAGS = $(inherited) -ObjC -l"ReactAppDependencyProvider" -l"ReactCodegen" -l"WatermelonDB" -l"simdjson" -l"sqlite3" -framework "Accelerate" -framework "AudioToolbox" -framework "CoreGraphics" -framework "ImageIO" -framework "MobileCoreServices" -framework "QuartzCore" -framework "React" -framework "ReactNativeDependencies" -framework "UIKit" -framework "hermesvm"
