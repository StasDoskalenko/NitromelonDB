#!/bin/bash

set -x
set -e

# Runs on an available iPhone simulator on the newest iOS runtime (scripts/pick-ios-simulator.sh,
# which also waits for one to show up on a fresh CI runner). A hardcoded device name broke when a
# runner image didn't have it. IOS_SIMULATOR_UDID overrides the pick.
#
# Optional split (not used in CI yet):
#   IOS_XCODEBUILD_ACTION=build-for-testing|test-without-building|test (default)
#   IOS_DERIVED_DATA_PATH=native/iosTest/DerivedData
ACTION="${IOS_XCODEBUILD_ACTION:-test}"
SIM_UDID="${IOS_SIMULATOR_UDID:-}"
if [ -z "$SIM_UDID" ]; then
  read -r SIM_UDID SIM_NAME < <("$(dirname "$0")/pick-ios-simulator.sh")
  echo "Testing on $SIM_NAME ($SIM_UDID)"
fi
DESTINATION="platform=iOS Simulator,id=$SIM_UDID"

args=(
  -workspace native/iosTest/WatermelonTester.xcworkspace
  -scheme 'WatermelonTester'
  -destination "$DESTINATION"
)

if [ -n "${IOS_DERIVED_DATA_PATH:-}" ]; then
  args+=(-derivedDataPath "$IOS_DERIVED_DATA_PATH")
fi

xcodebuild "${args[@]}" "$ACTION"
