{
  "name": "nitromelondb-sync-server",
  "version": "1.0.0",
  "private": true,
  "description": "Reference sync backend for NitromelonDB: pull/push endpoints on Hono + SQLite",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node --watch src/main.ts",
    "start:notes-app": "SYNC_SERVER_SCHEMA=notes-app SYNC_SERVER_TEST_HOOKS=1 DATABASE=:memory: node src/main.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "better-sqlite3": "13.0.3",
    "hono": "4.13.16"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "yarn@4.18.0"
}
