{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "skipLibCheck": true,
    "paths": {
      "nitromelondb": ["../../src/index.ts"],
      "nitromelondb/*": ["../../src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "../../src/ambient.d.ts"],
  "exclude": ["node_modules", "ios", "android"]
}
