{
  "name": "notes-app",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start --dev-client",
    "start:e2e": "expo start --dev-client --no-dev",
    "metro:kill": "node ../NotesApp_windows/scripts/kill-metro.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "e2e": "maestro test maestro/",
    "prebuild": "expo prebuild",
    "web": "expo start --web",
    "test:web": "expo export -p web --output-dir dist-web-test && playwright test",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@shopify/flash-list": "^2.3.2",
    "expo": "~58.0.17",
    "expo-dev-client": "~58.0.14",
    "expo-glass-effect": "~58.0.4",
    "expo-status-bar": "~58.0.4",
    "nitromelondb": "link:../..",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-nitro-modules": "0.36.5",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "rxjs": "^7.8.2",
    "sql-escape-string": "^1.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "resolutions": {
    "@expo/plist/@xmldom/xmldom": "^0.8.15",
    "plist/@xmldom/xmldom": "^0.9.12",
    "@expo/xcpretty/js-yaml": "^4.3.2",
    "xcode/uuid": "^11.1.1"
  },
  "packageManager": "yarn@4.18.0"
