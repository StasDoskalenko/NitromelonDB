{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strict": true,
    "skipLibCheck": true,
    "target": "ESNext",
    "ignoreDeprecations": "6.0",
    "jsx": "react-jsx",
    "paths": {
      // this allows sub-package imports from src; fx. '@nozbe/watermelondb/decorators'
      "@nozbe/watermelondb/*": ["../../src/*"]
    }
  },
  "include": [
    "./*.ts",
    "../../src/**/*.d.ts"
  ]
}
